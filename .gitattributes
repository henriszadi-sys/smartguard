# Auto detect text files and perform LF normalization
* text=auto

# Fichiers binaires : jamais de conversion de fins de ligne
*.pdf binary
*.exe binary
*.zip binary
*.png binary

# Sources Go, pages web et scripts : fins de ligne Unix (gofmt)
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.html text eol=lf
*.js text eol=lf
*.xlsx binary
*.docx binary
*.pptx binary
